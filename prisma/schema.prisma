// ===========================================================================
//  S.E.S Mobile World - Prisma Schema (PostgreSQL)
//  Wholesale Mobile Spare Parts, Accessories & Electronics
//  Bangarpet, Karnataka - 563114
//
//  MIGRATION SAFETY: all migrations must be additive. Never use
//  `prisma migrate reset` or `--force` against a production database.
// ===========================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm]
}

// ===========================================================================
//  ENUMS
// ===========================================================================

enum Role {
  CUSTOMER
  RETAILER
  ADMIN
  EDITOR
}

enum RetailerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  COMING_SOON
}

enum EnquiryType {
  PRODUCT
  GENERAL
  BULK
  RETAILER
  CONTACT
  WHOLESALE
  WISHLIST
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
  SPAM
}

enum ContactSubject {
  GENERAL
  PRODUCT_ENQUIRY
  WHOLESALE
  RETAILER_ONBOARDING
  ORDER_STATUS
  COMPLAINT
  OTHER
}

enum UserType {
  CUSTOMER
  RETAILER
  ADMIN
  GUEST
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
  ICON
  LOGO
}

enum MediaUsage {
  PRODUCT_MAIN
  PRODUCT_GALLERY
  PRODUCT_PACKAGING
  PRODUCT_SPEC
  PROMOTIONAL
  CATEGORY
  BANNER
  BRAND
  BRAND_LOGO
  AVATAR
  GENERAL
  OG
}

enum NotificationType {
  NEW_ENQUIRY
  NEW_RETAILER
  RETAILER_APPROVED
  RETAILER_REJECTED
  LOW_STOCK
  NEW_REVIEW
  CONTACT_FORM
  BULK_ENQUIRY
  PRODUCT_CREATED
  PRODUCT_UPDATED
  SYSTEM
  SECURITY
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  PUBLISH
  UNPUBLISH
  LOGIN
  LOGOUT
  LOGIN_FAILED
  LOGOUT_ALL
  PASSWORD_CHANGE
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET
  APPROVE
  REJECT
  SUSPEND
  IMPORT
  EXPORT
  BACKUP
  RESTORE
  SETTINGS_UPDATE
  MEDIA_UPLOAD
  MEDIA_DELETE
  TWOFA
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountType {
  NONE
  PERCENTAGE
  FIXED_AMOUNT
}

enum PriceVisibility {
  HIDDEN
  PUBLIC
  RETAILER_ONLY
}

// ===========================================================================
//  AUTHENTICATION & USERS
// ===========================================================================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String    @unique
  name          String
  passwordHash  String
  role          Role      @default(CUSTOMER)
  status        RetailerStatus @default(APPROVED) // for non-retailers this stays APPROVED
  avatarUrl     String?
  emailVerified DateTime?
  phoneVerified DateTime?
  lastLoginAt   DateTime?
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  totpSecret    String? // 2FA-ready architecture
  totpEnabled   Boolean   @default(false)
  recoveryCodes String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  retailerProfile  RetailerProfile?
  sessions         Session[]
  passwordResets   PasswordResetToken[]
  wishlistItems    WishlistItem[]
  enquiries        Enquiry[]
  bulkEnquiries    BulkEnquiry[]
  reviews          Review[]
  activityLogs     ActivityLog[]
  recentlyViewed   RecentlyViewed[]
  notificationsRead NotificationRead[]
  contactSubmissions ContactSubmission[]

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  ipAddress  String?
  success    Boolean
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model RetailerProfile {
  id                    String         @id @default(cuid())
  userId                String         @unique
  businessName          String
  contactName           String
  businessType          String?
  phone                 String
  whatsapp              String?
  email                 String?
  shopAddress           String
  city                  String
  state                 String
  pincode               String?
  gstin                 String?
  categoriesInterested  String[]
  monthlyVolume         String?
  status                RetailerStatus @default(PENDING)
  approvedAt            DateTime?
  approvedById          String?
  rejectionReason       String?
  notes                 String?
  documentUrl           String?
  lastEnquiryAt         DateTime?
  totalEnquiries        Int            @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([gstin])
  @@map("retailer_profiles")
}

// ===========================================================================
//  CATALOGUE STRUCTURE
// ===========================================================================

model Category {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  description   String?
  shortDescription String?
  icon          String?  // lucide icon key
  imageUrl      String?
  thumbnailUrl  String?
  parentId      String?
  position      Int     @default(0)
  isActive      Boolean @default(true)
  isFeatured    Boolean @default(false)
  showInNav     Boolean @default(true)
  showInFooter  Boolean @default(true)
  // SEO
  seoTitle      String?
  seoDescription String?
  seoKeywords   String?
  ogImageUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryTree")
  products     Product[]  @relation("CategoryProducts")
  subProducts  Product[]  @relation("Subcategory")

  @@index([parentId, position])
  @@index([isActive, position])
  @@index([slug])
  @@map("categories")
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  website     String?
  country     String?
  isPartner   Boolean  @default(false) // explicitly an official relationship
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive, name])
  @@map("brands")
}

model Product {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  sku               String        @unique
  shortDescription  String?
  description       String?
  // Pricing (all amounts stored in INR paise-safe integers, i.e. rupees)
  mrp               Decimal?      @db.Decimal(12, 2)
  costPrice         Decimal?      @db.Decimal(12, 2) // ADMIN ONLY - never serialised publicly
  customerPrice     Decimal?      @db.Decimal(12, 2)
  retailerPrice     Decimal?      @db.Decimal(12, 2) // PROTECTED - server-authorised only
  // Price visibility toggles
  showMrp           Boolean       @default(true)
  showCustomerPrice Boolean       @default(true)
  showRetailerPrice Boolean       @default(true)
  showDiscount      Boolean       @default(true)
  discountType      DiscountType  @default(PERCENTAGE)
  discountValue     Decimal?      @db.Decimal(6, 2)
  // Relations
  brandId           String?
  categoryId        String?
  subcategoryId     String?
  // Models this part fits (comma separated or JSON array of strings)
  supportedModels   String[]
  // Merchandising flags
  status            ProductStatus @default(ACTIVE)
  stockStatus       StockStatus   @default(IN_STOCK)
  stockQuantity     Int           @default(0)
  lowStockThreshold Int           @default(5)
  minimumOrderQty   Int           @default(1)
  minimumWholesaleQty Int         @default(1)
  wholesaleOnly     Boolean       @default(false)
  isFeatured        Boolean       @default(false)
  isBestSeller      Boolean       @default(false)
  isNewArrival      Boolean       @default(true)
  isWholesaleDeal   Boolean       @default(false)
  badge             String? // NEW | BEST SELLER | FEATURED | LIMITED STOCK | OUT OF STOCK
  position          Int           @default(0)
  // SEO
  seoTitle          String?
  seoDescription    String?
  seoKeywords       String?
  ogImageUrl        String?
  canonicalUrl      String?
  // Search
  searchKeywords    String?
  // Analytics counters (privacy-conscious aggregates)
  viewCount         Int           @default(0)
  enquiryCount      Int           @default(0)
  whatsappClickCount Int          @default(0)
  wishlistCount     Int           @default(0)
  // Demo flag
  isDemo            Boolean       @default(false)
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  brand        Brand?      @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category     Category?   @relation("CategoryProducts", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory  Category?   @relation("Subcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  images       ProductImage[]
  variants     ProductVariant[]
  inventoryLogs InventoryLog[]
  wishlistItems WishlistItem[]
  wishlistSessionItems WishlistSessionItem[]
  enquiries    Enquiry[]
  bulkItems    BulkEnquiryItem[]
  reviews      Review[]
  recentlyViewed RecentlyViewed[]
  analytics     ProductAnalytics[]

  @@index([status, isFeatured])
  @@index([status, isNewArrival])
  @@index([status, isBestSeller])
  @@index([categoryId, status])
  @@index([subcategoryId, status])
  @@index([brandId, status])
  @@index([stockStatus])
  @@index([position])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([isDemo])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  thumbnailUrl String?
  blurDataUrl String?
  alt       String?
  usage     MediaUsage @default(PRODUCT_GALLERY)
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  width     Int?
  height    Int?
  bytes     Int?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  name         String
  sku          String?  @unique
  optionKey    String?  // e.g. "Color"
  optionValue  String?  // e.g. "Black"
  mrp          Decimal? @db.Decimal(12, 2)
  customerPrice Decimal? @db.Decimal(12, 2)
  retailerPrice Decimal? @db.Decimal(12, 2)
  costPrice    Decimal? @db.Decimal(12, 2)
  stockQuantity Int     @default(0)
  stockStatus  StockStatus @default(IN_STOCK)
  isActive     Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isActive])
  @@map("product_variants")
}

model InventoryLog {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  type      String // IN | OUT | ADJUST | RETURN | DAMAGE
  quantity  Int
  balanceAfter Int
  note      String?
  createdById String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("inventory_logs")
}

// ===========================================================================
//  ENQUIRIES / LEADS
// ===========================================================================

model Enquiry {
  id          String        @id @default(cuid())
  reference   String        @unique
  name        String
  phone       String
  email       String?
  userType    UserType      @default(GUEST)
  userId      String?
  productId   String?
  productName String?
  sku         String?
  type        EnquiryType   @default(PRODUCT)
  subject     String?
  message     String
  priceShown  Decimal?      @db.Decimal(12, 2)
  priceTier   String? // customer | retailer
  quantity    Int?
  pageUrl     String?
  source      String?
  status      EnquiryStatus @default(NEW)
  notes       String?
  assignedToId String?
  contactedAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([userType, createdAt])
  @@index([phone])
  @@index([email])
  @@map("enquiries")
}

model BulkEnquiry {
  id          String        @id @default(cuid())
  reference   String        @unique
  name        String
  phone       String
  email       String?
  userId      String?
  userType    UserType      @default(GUEST)
  message     String?
  status      EnquiryStatus @default(NEW)
  notes       String?
  itemCount   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items BulkEnquiryItem[]

  @@index([status, createdAt])
  @@map("bulk_enquiries")
}

model BulkEnquiryItem {
  id            String   @id @default(cuid())
  bulkEnquiryId String
  productId     String?
  productName   String
  sku           String?
  quantity      Int      @default(1)
  priceShown    Decimal? @db.Decimal(12, 2)
  priceTier     String?
  createdAt     DateTime @default(now())

  bulkEnquiry BulkEnquiry @relation(fields: [bulkEnquiryId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([bulkEnquiryId])
  @@map("bulk_enquiry_items")
}

model ContactSubmission {
  id           String          @id @default(cuid())
  name         String
  phone        String
  email        String?
  customerType UserType        @default(CUSTOMER)
  subject      ContactSubject  @default(GENERAL)
  message      String
  status       EnquiryStatus   @default(NEW)
  notes        String?
  ipAddress    String?
  userAgent    String?
  userId       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([subject])
  @@map("contact_submissions")
}

// ===========================================================================
//  REVIEWS / SOCIAL PROOF
// ===========================================================================

model Review {
  id        String       @id @default(cuid())
  productId String
  userId    String?
  authorName String
  authorEmail String?
  rating    Int
  title     String?
  body      String
  status    ReviewStatus @default(PENDING)
  isFeatured Boolean     @default(false)
  isVerified Boolean     @default(false)
  adminReply String?
  ipHash    String?
  helpfulCount Int       @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([status, createdAt])
  @@map("reviews")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  designation String?
  businessName String?
  city      String?
  avatarUrl String?
  rating    Int      @default(5)
  body      String
  isActive  Boolean  @default(true)
  isFeatured Boolean @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
  @@map("testimonials")
}

// ===========================================================================
//  WISHLIST / RECENTLY VIEWED
// ===========================================================================

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  notes     String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

model WishlistSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items WishlistSessionItem[]

  @@map("wishlist_sessions")
}

model WishlistSessionItem {
  id        String   @id @default(cuid())
  sessionId String
  productId String
  createdAt DateTime @default(now())

  session WishlistSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sessionId, productId])
  @@index([productId])
  @@map("wishlist_session_items")
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  productId String
  viewCount Int      @default(1)
  lastViewedAt DateTime @default(now())
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Signed-in visitors de-duplicate per (user, product); guests per
  // (session, product). Postgres treats NULLs as distinct, so the two
  // constraints never collide with each other.
  @@unique([userId, productId])
  @@unique([sessionId, productId])
  @@index([userId, lastViewedAt])
  @@index([sessionId, lastViewedAt])
  @@index([productId])
  @@map("recently_viewed")
}

// ===========================================================================
//  CMS: BANNERS, PAGES, FAQ, COUPONS
// ===========================================================================

model Banner {
  id           String   @id @default(cuid())
  title        String
  subtitle     String?
  eyebrow      String?
  imageUrl     String?
  mobileImageUrl String?
  videoUrl     String?
  ctaLabel     String?
  ctaUrl       String?
  secondaryCtaLabel String?
  secondaryCtaUrl   String?
  position     String   @default("HOME_HERO") // HOME_HERO | HOME_MID | HOME_BOTTOM | CATEGORY
  placement    BannerPlacement @default(FULL)
  textAlign    String   @default("left")
  theme        String   @default("dark")
  startDate    DateTime?
  endDate      DateTime?
  sortOrder    Int      @default(0)
  clickCount   Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, position, sortOrder])
  @@index([startDate, endDate])
  @@map("banners")
}

enum BannerPlacement {
  FULL
  CONTAINER
  HALF
  SIDEBAR
}

model Coupon {
  code             String     @id
  description      String?
  type             CouponType @default(PERCENTAGE)
  value            Decimal    @db.Decimal(10, 2)
  minOrderValue    Decimal?   @db.Decimal(12, 2)
  minQuantity      Int?
  maxDiscount      Decimal?   @db.Decimal(10, 2)
  usageLimit       Int?
  usageCount       Int        @default(0)
  perUserLimit     Int?
  startsAt         DateTime?
  expiresAt        DateTime?
  isActive         Boolean    @default(true)
  applicableTo     String     @default("ALL") // ALL | RETAILER | CUSTOMER
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([isActive, expiresAt])
  @@map("coupons")
}

model Faq {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String   @default("GENERAL")
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  showInSchema Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, position])
  @@map("faqs")
}

model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String?
  content        String
  coverImageUrl  String?
  template       String   @default("RICH_TEXT") // RICH_TEXT | CUSTOM
  isPublished    Boolean  @default(true)
  showInFooter   Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImageUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isPublished])
  @@map("pages")
}

// ===========================================================================
//  MEDIA LIBRARY
// ===========================================================================

model MediaAsset {
  id           String     @id @default(cuid())
  filename     String
  originalName String
  url          String
  thumbnailUrl String?
  blurDataUrl  String?
  mimeType     String
  kind         MediaKind  @default(IMAGE)
  usage        MediaUsage @default(GENERAL)
  width        Int?
  height       Int?
  bytes        Int
  alt          String?
  title        String?
  folder       String     @default("general")
  provider     String     @default("local")
  publicId     String?
  tags         String[]
  productId    String?
  uploadedById String?
  isOptimized  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([usage, createdAt])
  @@index([folder])
  @@index([productId])
  @@map("media_assets")
}

// ===========================================================================
//  SETTINGS
// ===========================================================================

model SiteSettings {
  id     String @id @default("default")
  // Business identity
  businessName       String  @default("S.E.S Mobile World")
  tagline            String  @default("Wholesale Mobile Spare Parts, Accessories & Electronics")
  ownerName          String  @default("Md. Saif")
  logoUrl            String?
  logoAltText        String?
  faviconUrl         String?
  ogImageUrl         String?
  // Contact
  phone              String  @default("+918892399728")
  whatsappNumber     String  @default("918892399728")
  email              String?
  alternatePhone     String?
  // Address
  addressLine1       String  @default("Behind Police Station, Bur Road")
  addressLine2       String  @default("Opp. Aishwarya Medical")
  city               String  @default("Bangarpet")
  state              String  @default("Karnataka")
  pincode            String  @default("563114")
  country            String  @default("India")
  latitude           Float?
  longitude          Float?
  googleMapsUrl      String?
  googleMapsEmbedUrl String?
  // Legal
  gstin              String  @default("29HYBR57857HI2J")
  // Business hours (JSON: [{ day, open, close, closed }])
  businessHours      Json?
  // Commerce
  currencyCode       String  @default("INR")
  currencySymbol     String  @default("₹")
  // Toggles
  retailerPricingEnabled Boolean @default(true)
  wholesaleLandingEnabled Boolean @default(true)
  showCostPriceToAdminOnly Boolean @default(true)
  allowGuestWishlist  Boolean @default(true)
  requireApprovalForRetailer Boolean @default(true)
  enableReviews       Boolean  @default(true)
  enableAnalytics     Boolean  @default(true)
  enablePwa           Boolean  @default(true)
  maintenanceMode     Boolean  @default(false)
  maintenanceMessage  String?
  // SEO
  seoTitle           String?
  seoDescription     String?
  seoKeywords        String?
  twitterHandle      String?
  // Footer
  footerAbout        String?
  footerCopyright    String?
  // Social
  socialLinks        SocialLink[]
  // Misc
  analyticsSnippet   String?
  customHead         String?
  customBodyEnd      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("site_settings")
}

model SocialLink {
  id        String   @id @default(cuid())
  settingsId String
  platform  String // instagram | facebook | whatsapp | youtube | x | linkedin | telegram
  label     String
  url       String
  icon      String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings SiteSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, platform])
  @@index([isActive, position])
  @@map("social_links")
}

// ===========================================================================
//  NOTIFICATIONS & AUDIT
// ===========================================================================

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String?
  link      String?
  priority  String           @default("NORMAL") // LOW | NORMAL | HIGH
  entityId  String?
  entityType String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  reads NotificationRead[]

  @@index([isRead, createdAt])
  @@index([type, createdAt])
  @@map("notifications")
}

model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@map("notification_reads")
}

model ActivityLog {
  id         String         @id @default(cuid())
  userId     String?
  userName   String?
  userRole   Role?
  action     ActivityAction
  entityType String?
  entityId   String?
  entityName String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("activity_logs")
}

// ===========================================================================
//  ANALYTICS (privacy-conscious aggregates only)
// ===========================================================================

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String // PAGE_VIEW | PRODUCT_VIEW | CATEGORY_VIEW | SEARCH | WHATSAPP_CLICK | CALL_CLICK | ENQUIRY | RETAILER_REGISTER | PRODUCT_COMPARE
  entityType String?
  entityId   String?
  path       String?
  query      String?
  userType   UserType?
  sessionId  String?
  referrer   String?
  device     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("analytics_events")
}

model ProductAnalytics {
  id        String   @id @default(cuid())
  productId String
  date      DateTime @db.Date
  views     Int      @default(0)
  whatsappClicks Int @default(0)
  enquiries Int      @default(0)
  wishlists Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([date])
  @@map("product_analytics")
}

model DailyMetric {
  id        String @id @default(cuid())
  date      DateTime @db.Date @unique
  pageViews Int @default(0)
  productViews Int @default(0)
  categoryViews Int @default(0)
  searches Int @default(0)
  whatsappClicks Int @default(0)
  callClicks Int @default(0)
  enquiries Int @default(0)
  retailerRegistrations Int @default(0)
  newCustomers Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("daily_metrics")
}

model SearchQuery {
  id         String   @id @default(cuid())
  query      String
  normalised String
  resultCount Int     @default(0)
  clickedProductId String?
  userType   UserType?
  createdAt  DateTime @default(now())

  @@index([normalised, createdAt])
  @@index([createdAt])
  @@map("search_queries")
}

// ===========================================================================
//  OPERATIONS: BACKUPS, IMPORT LOGS
// ===========================================================================

model BackupRecord {
  id          String   @id @default(cuid())
  filename    String
  sizeBytes   Int?
  type        String   @default("AUTO") // AUTO | MANUAL
  storagePath String?
  checksum    String?
  status      String   @default("SUCCESS")
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("backup_records")
}

model ImportLog {
  id          String   @id @default(cuid())
  filename    String
  totalRows   Int      @default(0)
  validRows   Int      @default(0)
  invalidRows Int      @default(0)
  importedRows Int     @default(0)
  updatedRows Int      @default(0)
  errors      Json?
  status      String   @default("PENDING") // PENDING | VALIDATED | COMPLETED | FAILED
  createdById String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  rows ImportRow[]

  @@index([createdAt])
  @@map("import_logs")
}

model ImportRow {
  id         String   @id @default(cuid())
  importLogId String
  rowNumber  Int
  raw        Json
  errors     Json?
  isValid    Boolean  @default(false)
  productId  String?

  importLog ImportLog @relation(fields: [importLogId], references: [id], onDelete: Cascade)

  @@index([importLogId, isValid])
  @@map("import_rows")
}

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  name      String
  query     String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("saved_filters")
}
