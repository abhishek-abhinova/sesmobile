# ==========================================================================
# S.E.S Mobile World - Environment Configuration
# --------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.  NEVER commit `.env`.
#   cp .env.example .env
# All secrets are read server-side only. Only vars prefixed NEXT_PUBLIC_ are
# exposed to the browser.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# --------------------------------------------------------------------------
# Local Docker Compose:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&connection_limit=10&pool_timeout=20"
# Production VPS example:
# DATABASE_URL="postgresql://ses:CHANGE_ME@127.0.0.1:5432/ses?schema=public&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# --------------------------------------------------------------------------
# 2. APPLICATION / SITE URL
# --------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="S.E.S Mobile World"

# --------------------------------------------------------------------------
# 3. AUTHENTICATION  (generate with: openssl rand -base64 48)
# --------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-64-char-random-string"
AUTH_TOKEN_TTL_HOURS="168"
NEXT_PUBLIC_AUTH_MAX_AGE_HOURS="168"
ADMIN_EMAIL="owner@sesmobileworld.in"
# Password for the first admin account, used only by `npm run db:seed`.
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"

# --------------------------------------------------------------------------
# 4. BUSINESS DEFAULTS (seed values - override at runtime in Admin > Settings)
# --------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER="918892399728"
BUSINESS_PHONE="+918892399728"
BUSINESS_GSTIN="29HYBR57857HI2J"
BUSINESS_OWNER="Md. Saif"
GOOGLE_MAPS_URL="https://www.google.com/maps/search/?api=1&query=Behind+Police+Station%2C+Bur+Road%2C+Opp.+Aishwarya+Medical%2C+Bangarpet+-+563114%2C+Karnataka%2C+India"
GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps?q=Bur%20Road%2C%20Bangarpet%2C%20Karnataka%20563114&output=embed"

# --------------------------------------------------------------------------
# 5. MEDIA STORAGE  (Cloudinary or any S3-compatible provider)
# --------------------------------------------------------------------------
# Leave CLOUDINARY_* blank to fall back to local disk storage at /public/uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="ses-mobile-world"
NEXT_PUBLIC_MEDIA_PROVIDER="local"
MAX_UPLOAD_SIZE_MB="8"

# Optional S3-compatible (MinIO / R2 / Spaces) - used when provider = s3
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# --------------------------------------------------------------------------
# 6. EMAIL / SMTP  (Gmail example in README)
# --------------------------------------------------------------------------
SMTP_ENABLED="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="S.E.S Mobile World"
SMTP_FROM_EMAIL="no-reply@sesmobileworld.in"
ADMIN_NOTIFY_EMAIL="owner@sesmobileworld.in"
RETAILER_NOTIFY_EMAIL=""

# --------------------------------------------------------------------------
# 7. RATE LIMITING
# --------------------------------------------------------------------------
RATE_LIMIT_ENABLED="true"
LOGIN_RATE_LIMIT_MAX_ATTEMPTS="5"
LOGIN_RATE_LIMIT_WINDOW_MINUTES="15"
ENQUIRY_RATE_LIMIT_MAX_ATTEMPTS="10"
ENQUIRY_RATE_LIMIT_WINDOW_MINUTES="10"

# --------------------------------------------------------------------------
# 8. ANALYTICS
# --------------------------------------------------------------------------
ANALYTICS_ENABLED="true"
ANALYTICS_RETENTION_DAYS="365"

# --------------------------------------------------------------------------
# 9. OPTIONAL INTEGRATIONS
# --------------------------------------------------------------------------
GOOGLE_ANALYTICS_ID=""
GOOGLE_TAG_MANAGER_ID=""
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps?q=Bur%20Road%2C%20Bangarpet%2C%20Karnataka%20563114&output=embed"

# --------------------------------------------------------------------------
# 10. DEPLOYMENT
# --------------------------------------------------------------------------
NODE_ENV="development"
DISABLE_INDEXING="false"
TRUST_PROXY="1"
